datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  OFFICIAL
  ADMIN
}

enum ServiceStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String?
  fullName      String
  citizenshipNo String?   @unique
  role          Role      @default(CITIZEN)
  isVerified    Boolean   @default(false)
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  applications  GovernmentApplication[]
  complaints    Complaint[]
  bloodDonor    BloodDonorProfile?
  aiSessions    AISession[]
  notifications Notification[]

  @@index([email, phone])
}

model GovernmentApplication {
  id          String        @id @default(uuid())
  userId      String
  serviceType String        
  status      ServiceStatus @default(PENDING)
  formData    Json
  documents   String[]      
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Hospital {
  id           String   @id @default(uuid())
  name         String
  district     String
  address      String
  latitude     Float
  longitude    Float
  phone        String
  hasICU       Boolean  @default(false)
  hasEmergency Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model BloodDonorProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  bloodGroup   BloodGroup
  district     String
  lastDonated  DateTime?
  isAvailable  Boolean    @default(true)
  phoneVisible Boolean    @default(true)

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DisasterAlert {
  id          String        @id @default(uuid())
  title       String
  description String
  severity    AlertSeverity
  location    String
  latitude    Float?
  longitude   Float?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
}

model JobListing {
  id          String   @id @default(uuid())
  title       String
  company     String
  category    String   
  location    String
  salaryRange String?
  description String
  deadline    DateTime
  createdAt   DateTime @default(now())
}

model Complaint {
  id          String        @id @default(uuid())
  userId      String
  department  String
  subject     String
  details     String
  status      ServiceStatus @default(PENDING)
  response    String?
  createdAt   DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AISession {
  id        String   @id @default(uuid())
  userId    String
  messages  Json     
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}